# Copie este arquivo para ".env" (na mesma pasta) e preencha.
# Supabase → Project Settings → API

SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave "service_role" (secreta!). Nunca coloque no site, na Vercel ou no GitHub.
SUPABASE_SERVICE_ROLE_KEY=

# Opcional: quantas folhas converter ao mesmo tempo (padrão: núcleos da CPU ÷ 4, mínimo 2)
# WORKER_PARALELO=4

# Opcional: caminho do ODA File Converter, se não estiver em C:\Program Files\ODA\
# ODA_CONVERTER=C:\Program Files\ODA\ODAFileConverter 27.9.0\ODAFileConverter.exe
