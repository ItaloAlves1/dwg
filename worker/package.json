{
  "name": "conversor-pdf-dwg-worker",
  "version": "1.0.0",
  "private": true,
  "description": "Worker local: converte em DWG os PDFs enviados pelo site (fila no Supabase).",
  "type": "module",
  "engines": { "node": ">=20.11" },
  "scripts": {
    "start": "node --env-file=.env worker.mjs",
    "converter": "node convert.mjs"
  },
  "dependencies": {
    "@napi-rs/canvas": "0.1.65",
    "@supabase/supabase-js": "2.45.4",
    "pdfjs-dist": "4.10.38",
    "tesseract.js": "5.1.1"
  }
}
