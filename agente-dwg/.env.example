# Configuração do agente DWG. O instalador cria o arquivo ".env" a partir deste.
# Supabase → Project Settings → API Keys

SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave "service_role" (secreta!): fica só neste PC. Nunca coloque no site, na Vercel ou no GitHub.
SUPABASE_SERVICE_ROLE_KEY=

# Opcional: caminho do ODA File Converter, se não estiver na pasta "oda" ao lado do agente
# ODA_CONVERTER=C:\Program Files\ODA\ODAFileConverter 27.9.0\ODAFileConverter.exe
